    {
      "name": "memory",
      "title": "Memory",
      "subtitle": "View everything related to memory",
      "description": "Shows memory pressure, composition, and apps sorted by RAM usage.",
      "mode": "view"
    },
    {
      "name": "cpu",
      "title": "CPU",
      "subtitle": "View everything related to the CPU",
      "description": "Shows core grid, total CPU graph, and apps sorted by CPU usage",
      "mode": "view"
    },
    {
      "name": "gpu",
      "title": "GPU",
      "subtitle": "View everything related to the GPU",
      "description": "Shows GPU graphs, usage category breakdown, and apps sorted by GPU usage",
      "mode": "view"
    },
    {
      "name": "disk",
      "title": "Disk",
      "subtitle": "View everything related to disk read/writes",
      "description": "Shows read/write throughput graphs and apps sorted by disk I/O",
      "mode": "view"
    },
    {
      "name": "energy",
      "title": "Energy",
      "subtitle": "View everything related to power usage & thermals",
      "description": "Shows power consumption, thermals, and apps sorted by energy impact",
      "mode": "view"
    },
    {
      "name": "copy-ai-instructions",
      "title": "Copy AI Instructions",
      "subtitle": "Copy Data Context to Clipboard for Agents",
      "description": "Copies structured context and database rules for AI agents",
      "mode": "no-view"
    }
  ],
